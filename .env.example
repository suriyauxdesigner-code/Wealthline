# Supabase (client-side; Next.js requires the NEXT_PUBLIC_ prefix to expose
# a variable to the browser — Vite's VITE_ prefix does not apply here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side only; never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Brandfetch (https://developers.brandfetch.com) — free "Client ID" (not a
# secret key: Brandfetch's own docs embed it directly in <img> tags), used
# for merchant logo search/autocomplete and brand logo images. Optional —
# merchant matching falls back to Simple Icons / initials / category icons
# when this is unset.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# A value you invent yourself (e.g. a random 32+ char string) — checked
# against the Authorization header on /api/cron/exchange-rate so only
# Vercel Cron (configured with the same value) can trigger it. Also set this
# as an Environment Variable on the Vercel project itself, where Vercel Cron
# reads it to sign its requests.
CRON_SECRET=
